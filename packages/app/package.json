{
  "name": "@miai/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "MIAI App – menu-bar-app, der kører MIAI Bridge lokalt (ADR-0008, udgave B)",
  "author": "M. Wiingaard",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dist:mac": "npm run icons && electron-builder --mac"
  },
  "dependencies": {
    "@fastify/static": "^10.0.0",
    "@miai/bridge": "0.1.0",
    "@miai/shared": "0.1.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dk.miai.app",
    "productName": "MIAI",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.category-productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "extraResources": [
        { "from": "../addin/dist", "to": "addin" },
        { "from": "../addin/manifest.xml", "to": "manifest.xml" }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
