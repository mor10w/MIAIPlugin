{
  "name": "@miai/app",
  "version": "0.1.21",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "description": "MIAI App – menu-bar-app, der kører MIAI Bridge lokalt (ADR-0008, udgave B)",
  "author": "ManInfo ApS",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "notices": "node ../../scripts/third-party-notices.mjs app build/THIRD-PARTY-NOTICES.txt",
    "start": "electron .",
    "dist:mac": "npm run icons && npm run notices && electron-builder --mac --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:win": "npm run icons && npm run notices && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.0.0",
    "@miai/bridge": "0.1.0",
    "@miai/shared": "0.1.0",
    "@napi-rs/keyring": "^2.1.2",
    "electron-updater": "^6.8.11",
    "fastify": "^5.6.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "selfsigned": "^5.5.0",
    "unpdf": "~1.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dk.miai.app",
    "productName": "MIAI",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "platform.js",
      "updates.js",
      "devBuild.js",
      "updateState.js",
      "instance.js",
      "bridge-process.mjs",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.category-productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "extraResources": [
      {
        "from": "../addin/dist",
        "to": "addin"
      },
      {
        "from": "../addin/manifest.xml",
        "to": "manifest.xml"
      },
      {
        "from": "../addin/manifest.outlook.xml",
        "to": "manifest.outlook.xml"
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "shortcutName": "MIAI",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mor10w.github.io/MIAIPlugin/updates/"
      }
    ]
  }
}
