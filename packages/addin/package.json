{
  "name": "@miai/addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.dev.xml"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "^2.0.300",
    "@miai/shared": "0.1.0",
    "dompurify": "^3.2.0",
    "marked": "^18.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.500",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "office-addin-manifest": "^3.0.0",
    "vite": "^8.0.0"
  }
}
