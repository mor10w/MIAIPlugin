{
  "name": "miaiplugin",
  "private": true,
  "version": "0.1.0",
  "description": "AI-assistent til Word, Excel og PowerPoint mod lokale OpenAI-kompatible modeller",
  "workspaces": [
    "packages/shared",
    "packages/bridge",
    "packages/addin",
    "packages/app"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @miai/shared && npm run build -w @miai/bridge && npm run build -w @miai/addin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @miai/bridge",
    "dev": "npm run build -w @miai/shared && npm run dev -w @miai/addin",
    "certs": "office-addin-dev-certs install",
    "sideload:mac": "node scripts/sideload-mac.mjs",
    "sideload:windows": "powershell -ExecutionPolicy Bypass -File scripts/sideload-windows.ps1",
    "icons": "node scripts/make-icons.mjs",
    "dev:bridge": "npm run build -w @miai/shared && concurrently -n addin,bridge \"npm run watch -w @miai/addin\" \"npm run dev -w @miai/bridge\"",
    "manifests": "node scripts/make-manifest.mjs",
    "test:e2e": "npm run test:e2e -w @miai/addin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "office-addin-dev-certs": "^3.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
